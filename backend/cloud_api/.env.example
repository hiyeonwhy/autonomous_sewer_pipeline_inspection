# cloud_api 가 읽는 설정. 실제 파일은 backend/cloud_api/.env 이고 git 이
# 추적하지 않는다. 여기 있는 키는 전부 app/core/config.py 의 Settings 와 1:1로
# 맞춘다 — Settings 는 extra="ignore" 라 오타나 없어진 키를 조용히 무시한다.

MONGODB_URL=mongodb://사용자명:비밀번호@mongodb:27017/sewer_inspection?authSource=admin
MONGODB_DB_NAME=sewer_inspection

# 업로드된 사진이 쌓이는 곳. compose 가 media_data 볼륨을 여기에 붙인다.
MEDIA_ROOT=/app/media

# 우선순위 엔진 산출물 위치. 배포 이미지에서는 Dockerfile 이 산출물을 굽고 이 값을
# 직접 넣으므로 신경 쓸 필요 없다. 로컬에서는 비워 두면 저장소 레이아웃
# (backend/priority_engine/data)을 쓴다.
PRIORITY_DATA_DIR=

# 보고서 서술형 요약(LLM). 「보고서 출력」으로 PDF를 처음 받을 때 한 번 돌고,
# 그 뒤로는 DB에 저장된 요약을 그대로 쓴다.
# 키를 비워 두면 규칙 기반 요약으로 내려가며 PDF는 그대로 나온다.
LLM_ENABLED=true
# SSAFY GMS는 OpenAI 호환. 도메인을 경로에 끼워 중계한다.
LLM_API_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
# 실제 키는 여기가 아니라 .env에 넣는다. 이 파일은 git이 추적한다.
LLM_API_KEY=
LLM_MODEL=
# 결함 사진 판독용 모델. 비우면 LLM_MODEL을 그대로 쓴다.
LLM_VISION_MODEL=
LLM_TIMEOUT_S=60
# 사진 판독은 결함 1건당 호출 1회다. 끄려면 false.
LLM_DESCRIBE_IMAGES=true
LLM_MAX_VISION_DEFECTS=8
# 사진 1장을 이 크기 이하로 줄여 보낸다. GMS 는 본문이 약 100KB를 넘으면 400.
LLM_IMAGE_BUDGET_BYTES=61440

# 참고: 서버 .env 에 있는 UPLOAD_TOKEN / MEDIA_URL_PREFIX / MAX_UPLOAD_BYTES 는
# 저장소 어디서도 읽지 않는다. MAX_UPLOAD_BYTES 는 app/domain/media/router.py 에
# 10MB로 하드코딩돼 있어 값을 바꿔도 효과가 없다. 되살릴 게 아니면 지워도 된다.
