# Real Raspberry Pi Edge motor bridge. Runtime startup fails if either is missing.
PIPECHECKKK_EDGE_URL=http://192.168.100.246:8765
PIPECHECKKK_EDGE_TOKEN=REPLACE_WITH_THE_SAME_RANDOM_TOKEN_AS_PI

# Existing Raspberry Pi camera service.
PIPECHECKKK_CAMERA_SNAPSHOT_URL=http://192.168.100.246:8081/snapshot.jpg

# AI API is local-only by default.
PIPECHECKKK_AI_HOST=127.0.0.1
PIPECHECKKK_AI_PORT=8000

# Deployed EC2 Dashboard telemetry/frame sink. Robot control remains local.
PIPECHECKKK_CLOUD_API_URL=https://i15c102.p.ssafy.io
PIPECHECKKK_AGENT_ID=laptop-4070
# WebSocket 영상 목표 주기: 0.1초(10fps).
PIPECHECKKK_CLOUD_PUBLISH_INTERVAL_S=0.1
# telemetry API를 인증할 때만 선택적으로 설정합니다. 영상 WebSocket에는 사용하지 않습니다.
PIPECHECKKK_CLOUD_PUBLISH_KEY=
