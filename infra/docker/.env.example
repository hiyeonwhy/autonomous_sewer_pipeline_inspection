# docker-compose.prod.yml 이 읽는 유일한 설정 파일. 실제 파일은 infra/docker/.env
# 이고 git 이 추적하지 않는다.
#
#   cp infra/docker/.env.example infra/docker/.env
#
# compose 의 ${...} 치환과 cloud-api 의 env_file 이 **같은 파일**을 읽는다. 그래서
# 비밀값이 한 군데에만 존재하고, CI 는 credential 하나만 이 경로에 심으면 된다.
#
# 로컬에서 cloud_api 를 직접 띄울 때는 이 파일이 아니라 backend/cloud_api/.env 를
# 쓴다 (Settings 가 cwd 의 .env 를 읽는다). 키 목록은 그쪽 .env.example 참고.

# 주의: MONGO_USER/MONGO_PASSWORD 는 mongodb 볼륨이 **처음 만들어질 때만** 계정
# 생성에 쓰인다. 이미 데이터가 있는 볼륨에서 값만 바꾸면 계정은 그대로인데
# 헬스체크와 접속만 깨진다. 비밀번호를 바꾸려면 DB 안에서 같이 바꿔야 한다.
MONGO_USER=
MONGO_PASSWORD=

# GIT_COMMIT 은 이 파일에 두지 않는다. compose 는 이 파일을 ${...} 치환에도 쓰고
# cloud-api 의 env_file 로도 쓰기 때문에, 여기 빈 값으로 있으면 컨테이너 환경변수를
# 빈 문자열로 덮어써서 Dockerfile 이 구워 넣은 커밋이 사라진다. 배포할 때 셸에서
# 넘긴다:  GIT_COMMIT=$(git rev-parse --short HEAD) docker-compose ... up -d --build

# MONGODB_URL 은 여기 두지 않는다 — compose 가 위 두 값으로 조립한다.
MONGODB_DB_NAME=sewer_inspection

# 업로드된 사진이 쌓이는 곳. compose 가 media_data 볼륨을 여기에 붙인다.
MEDIA_ROOT=/app/media

# 선택값: Laptop Agent의 telemetry/log 쓰기 인증 키.
# 영상 WebSocket 업로드에는 사용하지 않는다.
AGENT_PUBLISH_KEY=

# 보고서 서술형 요약(LLM). 키를 비워 두면 규칙 기반 요약으로 내려가며 PDF는 그대로
# 나온다 — 설정 누락이 다운로드를 막지는 않는다.
LLM_ENABLED=true
# SSAFY GMS는 OpenAI 호환. 도메인을 경로에 끼워 중계한다.
LLM_API_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
# 실제 키는 이 파일이 아니라 infra/docker/.env 와 Jenkins credential 에만 둔다.
# 이 파일은 git 이 추적하므로 값을 채워 커밋하면 저장소에 그대로 공개된다.
LLM_API_KEY=
LLM_MODEL=gpt-5.1
# 결함 사진 판독용 모델. 비우면 LLM_MODEL을 그대로 쓴다.
LLM_VISION_MODEL=gpt-5.1
LLM_TIMEOUT_S=60
LLM_DESCRIBE_IMAGES=true
LLM_MAX_VISION_DEFECTS=8
LLM_IMAGE_BUDGET_BYTES=61440
